# =============================================================================
# Standard .gitignore for Neural-Entropy-Search
# Chặn hoàn toàn các file thực thi, thư viện động và dữ liệu nhị phân
# =============================================================================

# Binary & Compiled Dynamic Libraries
*.dll
*.so
*.dylib
*.a
*.lib
*.exe
*.o
*.obj

# Weight Checkpoints & Binary Model Data
*.bin
*.npz
*.weights
models/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual Environments
.venv/
venv/
ENV/
env/

# IDE & Editor Metadata
.vscode/
.idea/
*.swp
*.swo

# Media & Screenshots
*.png
*.jpg
*.jpeg
.user_uploaded/

# OS-specific
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
